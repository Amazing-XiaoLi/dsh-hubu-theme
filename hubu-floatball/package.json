{
  "name": "hubu-floatball",
  "version": "1.0.0",
  "private": true,
  "description": "校标悬浮球：点击显示 DeepSeek 账户余额（1 秒限频），永久常驻客户端插件",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  }
}
